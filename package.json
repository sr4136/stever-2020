{
	"name": "stever-theme",
	"version": "1.0.0",
	"description": "A modern WordPress theme with Gulp-based build tooling",
	"license": "GPL-2.0-or-later",
	"homepage": "https://github.com/sr4136/stever-theme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sr4136/stever-theme.git"
	},
	"bugs": {
		"url": "https://github.com/sr4136/stever-theme/issues"
	},
	"scripts": {
		"build": "gulp sass",
		"format:sass": "prettier --write \"sass/**/*.scss\"",
		"watch:sass": "gulp watch",
		"watch:format": "chokidar \"sass/**/*.scss\" -c \"prettier --write {path}\"",
		"watch": "concurrently \"npm:watch:sass\" \"npm:watch:format\"",
		"dev": "npm run watch"
	},
	"devDependencies": {
		"chokidar-cli": "^3.0.0",
		"concurrently": "^9.2.1",
		"gulp": "^5.0.1",
		"gulp-cssnano": "^2.1.3",
		"gulp-rename": "^2.1.0",
		"gulp-sass": "^6.0.1",
		"prettier": "^3.6.2",
		"sass": "^1.99.0"
	}
}
